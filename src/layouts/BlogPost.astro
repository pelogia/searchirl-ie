---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, heroImageAlt } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<Header />
		<main class="post-main">
			<article class="prose">
				<div class="title">
					<span class="eyebrow">
						<FormattedDate date={pubDate} />
						{
							updatedDate && (
								<>
									{' '}
									· <span class="accent">updated</span> <FormattedDate date={updatedDate} />
								</>
							)
						}
					</span>
					<h1>{title}</h1>
				</div>
				{heroImage && <Image class="hero-image" width={1020} height={510} src={heroImage} alt={heroImageAlt ?? ''} />}
				<hr class="rule" />
				<div class="body">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.post-main {
		width: 100%;
		max-width: 100%;
		padding: 0;
	}
	.prose {
		width: 75%;
		max-width: calc(100% - 2em);
		margin: 2em auto;
		padding: 0 1em;
	}
	@media (max-width: 600px) {
		.prose {
			width: 100%;
		}
	}
	.title {
		margin-bottom: 1.5em;
	}
	.hero-image {
		width: 100%;
		margin: 1.5em 0;
	}
	.rule {
		margin: 2em 0;
	}
	.body :global(h2) {
		margin-top: 2em;
		padding-top: 0.75em;
		border-top: 1px solid rgb(var(--line));
	}
	.body :global(h3) {
		margin-top: 1.5em;
	}
	.body :global(img) {
		margin: 1em 0;
	}
	.body :global(a) {
		text-decoration-color: rgba(var(--ink), 0.3);
		text-underline-offset: 2px;
	}
</style>
