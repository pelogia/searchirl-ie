---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
const pageTitle = 'Blog | SearchIRL';
const description = 'Notes and updates from SearchIRL, the Dublin SEO meetup.';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={pageTitle} description={description} />
	</head>
	<body>
		<Header />
		<main class="index">
			<span class="eyebrow">All writing</span>
			<h1>/blog</h1>
			<hr class="rule" />
			<ol>
				{
					posts.map((post, i) => (
						<li>
							<a href={`/${post.id}`}>
								<span class="num">{String(i + 1).padStart(2, '0')}</span>
								<span class="title">{post.data.title}</span>
								<span class="date">
									<FormattedDate date={post.data.pubDate} />
								</span>
							</a>
						</li>
					))
				}
			</ol>
		</main>
		<Footer />
	</body>
</html>

<style>
	.index {
		width: 75%;
	}
	.index h1 {
		font-size: clamp(2.5rem, 6vw, 4rem);
		margin-bottom: 1.5rem;
	}
	.rule {
		margin-bottom: 0.5rem;
	}
	ol {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	li {
		border-bottom: 1px solid rgb(var(--line));
	}
	li a {
		display: grid;
		grid-template-columns: 3rem 1fr auto;
		align-items: baseline;
		gap: 1rem;
		padding: 1.1em 0.25em;
		text-decoration: none;
		color: inherit;
	}
	li a:hover {
		background: rgba(var(--ink), 3%);
	}
	li a:hover .title {
		color: var(--accent);
	}
	.num {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: rgb(var(--gray));
	}
	.title {
		font-family: var(--font-display);
		font-weight: 500;
		font-size: 1.1rem;
		color: rgb(var(--ink));
	}
	.date {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		color: rgb(var(--gray));
		white-space: nowrap;
	}
	@media (max-width: 600px) {
		.index {
			width: 100%;
		}
		li a {
			grid-template-columns: 2rem 1fr;
		}
		.date {
			grid-column: 2;
		}
	}
</style>
