---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

const title = 'Page not found | SearchIRL';
const description = "This page doesn't exist — you'll be redirected to the homepage.";
const redirectSeconds = 10;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<meta name="robots" content="noindex" />
		<meta http-equiv="refresh" content={`${redirectSeconds};url=/`} />
	</head>
	<body>
		<Header />
		<main class="prose">
			<span class="eyebrow">404</span>
			<h1>Page not found</h1>
			<hr class="rule" />
			<p>The page you're looking for doesn't exist or may have moved.</p>
			<p>
				Redirecting you to the homepage in <span id="countdown">{redirectSeconds}</span> seconds
				— or <a href="/">go there now →</a>.
			</p>
		</main>
		<Footer />
	</body>
</html>

<script define:vars={{ redirectSeconds }}>
	let secondsLeft = redirectSeconds;
	const countdownEl = document.getElementById('countdown');
	const timer = setInterval(() => {
		secondsLeft -= 1;
		if (countdownEl) countdownEl.textContent = String(Math.max(secondsLeft, 0));
		if (secondsLeft <= 0) {
			clearInterval(timer);
			window.location.href = '/';
		}
	}, 1000);
</script>

<style>
	.prose {
		width: 1100px;
		margin: 0 auto;
		padding: 4rem 1rem;
		text-align: center;
	}
	.rule {
		margin: 1.5rem auto;
		max-width: 160px;
	}
	.eyebrow {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		letter-spacing: 0.04em;
		color: var(--accent);
	}
	#countdown {
		font-family: var(--font-mono);
		font-weight: 600;
		color: var(--accent);
	}
</style>
